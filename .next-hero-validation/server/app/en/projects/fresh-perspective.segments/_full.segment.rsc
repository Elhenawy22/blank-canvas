b:[["$","$L1a",null,{}],["$","a",null,{"className":"skip-link","href":"#main-content","children":"Skip to content"}],["$","$L1b",null,{"dictionary":{"locale":"en","meta":{"title":"Ideas that reach further.","description":"A full-service creative and digital agency helping ambitious brands reach further."},"nav":{"links":[{"label":"Home","href":"#home"},{"label":"About","href":"#about"},{"label":"Services","href":"#services"},{"label":"Our work","href":"#work"},{"label":"Contact","href":"#contact"}],"menuOpen":"Open navigation menu","menuClose":"Close navigation menu","navAria":"Primary","overlayAria":"Main navigation","requestCta":"Request service","logoAria":"Reach Agency home","skipToContent":"Skip to content"},"language":{"aria":"Switch language","currentSuffix":"current language","switchTo":{"en":"Switch to Arabic — العربية","ar":"Switch to English — EN"},"footerHeading":"Language"},"preloader":{"label":"Loading","status":"Loading Reach Agency"},"hero":{"eyebrow":"Independent creative studio","title":["IDEAS THAT","REACH","FURTHER."],"titleAria":"Ideas that reach further","description":"A full-service creative and digital agency.","primaryCta":"Request service","secondaryCta":"See selected work","scrollCue":"Scroll to explore","socialAria":"Reach Agency on social media","socialMissing":"%s — link not configured yet. Add it in src/data/brand.ts."},"services":{"eyebrow":"What we do","lines":["Empowering brands through","innovative and modern solutions"],"description":"We bring strategy, design, and digital innovation together to help your brand move forward with purpose.","items":[{"title":"Digital Marketing","description":"Smart campaigns built to grow awareness and turn attention into measurable results."},{"title":"Brand Identity","description":"Distinctive visual identities that capture your character and make your brand memorable."},{"title":"Social Media","description":"Thoughtful strategy and content that gives your brand a more meaningful presence."},{"title":"Web Development","description":"Digital experiences that feel unmistakably yours and make every visit count."}],"cardAriaSuffix":" — start a project"},"milestones":{"eyebrow":"The bigger picture","lines":["Built on ideas.","Made to go further."],"description":"We believe the best work comes from staying curious, challenging ourselves, and making every detail matter.","stats":[{"value":"—","label":"Branding projects"},{"value":"—","label":"Campaigns managed"},{"value":"—","label":"Consultations"},{"value":"—","label":"Social designs"}],"note":"Verified studio figures coming soon"},"marquee":{"words":["Strategy","Design","Digital","Growth","Identity","Motion","Experience","Reach further"],"aria":"What we believe about ideas"},"principles":{"aria":"Our vision and mission","items":[{"symbol":"◎","title":"Our vision","copy":"To be the creative partner that helps ambitious brands build a digital presence with lasting impact."},{"symbol":"↗","title":"Our mission","copy":"We turn ideas into meaningful brand stories through creativity, strategy, and thoughtful digital experiences."}]},"work":{"eyebrow":"Selected concepts","lines":["Creativity is a matter of perspective.","Ours is always moving forward."],"filtersAria":"Filter projects by category","gridAria":"Selected concept projects","empty":"Demo concepts for this category are coming soon.","disclaimer":"These are visual concepts, not commissioned client projects.","projectType":"Concept project","categories":{"all":"View All","branding":"Branding","social":"Social Media","dev":"Programming and Design","photo":"Photography","video":"Videography"},"projectPage":{"backToWork":"Back to selected work","conceptLabel":"Visual concept · temporary AI-inspired artwork","overviewHeading":"The idea","approachHeading":"Creative direction","deliverablesHeading":"Concept elements","nextProject":"Next concept","contactCta":"Have a project in mind?","contactLink":"Let’s talk","imageCaption":"Temporary visual concept"},"projects":{"desert-notes":{"title":"Desert Notes","alt":"A warm, sculptural fragrance concept in desert-inspired tones","summary":"A sensory identity concept shaped by warm light, botanical forms, and a quiet sense of place.","brief":"Imagine a contemporary fragrance house inspired by the contrast between open desert landscapes and intimate evening rituals.","approach":"We paired tactile, dark packaging with sun-washed colors and restrained typography to create an identity that feels grounded yet elevated.","deliverables":["Brand direction","Packaging concept","Campaign art direction"]},"skin-simply":{"title":"Skin, simply","alt":"A minimal skincare concept set with soft pastel forms and botanical details","summary":"A calm visual language for a modern skincare line, centered on simple routines and thoughtful ingredients.","brief":"The concept explores how a young skincare label could make daily care feel clear, approachable, and considered.","approach":"Soft material cues, gentle color, and uncluttered compositions make the product family feel cohesive without losing its warmth.","deliverables":["Visual identity direction","Product packaging concept","Studio imagery"]},"color-in-motion":{"title":"Color in motion","alt":"Flowing blue, turquoise, and amber forms for a motion-led campaign concept","summary":"A flexible campaign world where fluid shapes and bold color bring a digital-first story to life.","brief":"This social campaign concept needed a visual system that could feel energetic across formats while remaining instantly recognizable.","approach":"Layered gradients, expressive curves, and a small set of repeatable graphic gestures create a playful, adaptable visual rhythm.","deliverables":["Campaign art direction","Social templates","Motion design direction"]},"fresh-perspective":{"title":"A fresh perspective","alt":"A contemporary digital product concept shown across a clean dashboard interface","summary":"A digital experience concept that turns a complex toolkit into a clearer, more welcoming workspace.","brief":"We imagined a small creative platform that helps teams bring scattered project details into one useful view.","approach":"A calm interface, clear hierarchy, and warm accent colors make the imagined product feel focused without feeling technical.","deliverables":["Digital product direction","Interface concept","Responsive web design"]}}},"contact":{"eyebrow":"Have a good one in mind?","lines":["Let’s make","something matter."],"linesAria":"Let’s make something matter","description":"Tell us where you want to go. We’ll help you find the way.","emailNote":"Email details to be added","form":{"nameLabel":"Your name","namePlaceholder":"Name","emailLabel":"Email address","submit":"Send an enquiry","messageLabel":"A little about your project","messagePlaceholder":"What would you like to make happen?","mailtoSubjectTemplate":"Project enquiry from %name%","mailtoBodyTemplate":"Name: %name%\nEmail: %email%\n\n%message%"},"emptyEmailNote":"Add your approved business email in src/data/brand.ts before publishing the contact form."},"footer":{"tagline":"Ideas that reach further.","aboutHeading":"Reach Agency","navHeading":"Site","servicesHeading":"Services","contactHeading":"Contact","navAria":"Footer navigation","servicesNote":"All our services start from here","copyright":"© %year% Reach Agency · Independent creative studio","credit":"Developed by Ahmed Elhenawy"},"notFound":{"title":"Page not found","body":"The page you are looking for does not exist or has moved.","home":"Back to home"}},"locale":"en","projectSlug":"fresh-perspective"}],"$L1c","$L1d"]
